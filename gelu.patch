@@ -24,10 +24,19 @@ exp = tl_extra_shim.exp
 pow = tl_extra_shim.pow
 tanh = tl_extra_shim.tanh
 
-
 logger = logging.getLogger(__name__)
 
 
+# wt-2026-09-10-fix (#5867): CANN's libdevice `pow` dispatch table only has
+# float/float operand pairs — {(fp32,fp32), (fp16,fp16), (bf16,bf16)} — while
+# a Python int literal (e.g. pow(x, 2)) types the exponent as int32, so the
+# (float32, int32) lookup raises KeyError and kills compilation of the whole
+# gelu tanh family on Ascend. Call sites below pass float exponents so the
+# lookup always lands on a supported pair. (Verified on CANN 8.5; issue
+# reports the same on CANN 9.0.)
+# wt <wangt635@ustc.edu.cn>
+
+
 @pointwise_dynamic(promotion_methods=[(0, "DEFAULT")])
 @triton.jit
 def gelu_none(x):
@@ -40,7 +49,9 @@ def gelu_none(x):
 @triton.jit
 def gelu_tanh(x):
     x_fp32 = x.to(tl.float32)
-    output = 0.5 * x * (1 + tanh(x_fp32 * 0.79788456 * (1 + 0.044715 * pow(x_fp32, 2))))
+    # wt-2026-09-10-fix (#5867): exponent as float, see note above
+    # wt <wangt635@ustc.edu.cn>
+    output = 0.5 * x * (1 + tanh(x_fp32 * 0.79788456 * (1 + 0.044715 * pow(x_fp32, 2.0))))
     return output
 
 
@@ -50,8 +61,10 @@ def gelu_backward_none(x, dy):
     scale1: tl.constexpr = 0.7071067811  # 1 / math.sqrt(2)
     scale2: tl.constexpr = 0.3989422803  # 1 / math.sqrt(2 * math.pi)
     x_fp32 = x.to(tl.float32)
+    # wt-2026-09-10-fix (#5867): exponent as float, see note above
+    # wt <wangt635@ustc.edu.cn>
     dydx = (
-        scale2 * x_fp32 * exp(-pow(scale1 * x_fp32, 2))
+        scale2 * x_fp32 * exp(-pow(scale1 * x_fp32, 2.0))
         + 0.5 * erf(scale1 * x_fp32)
         + 0.5
     )
@@ -64,9 +77,11 @@ def gelu_backward_none(x, dy):
 def gelu_backward_tanh(x, dy):
     x_fp32 = x.to(tl.float32)
     # 0.79788456 = math.sqrt(2 / math.pi)
-    tanh_out = tanh(0.79788456 * x_fp32 * (1 + 0.044715 * pow(x_fp32, 2)))
+    # wt-2026-09-10-fix (#5867): exponents as float, see note above
+    # wt <wangt635@ustc.edu.cn>
+    tanh_out = tanh(0.79788456 * x_fp32 * (1 + 0.044715 * pow(x_fp32, 2.0)))
     dydx = 0.5 * x_fp32 * (
-        (1 - pow(tanh_out, 2)) * (0.79788456 + 0.1070322243 * pow(x_fp32, 2))
+        (1 - pow(tanh_out, 2.0)) * (0.79788456 + 0.1070322243 * pow(x_fp32, 2.0))
     ) + 0.5 * (1 + tanh_out)
     dx = dydx * dy
     return dx
